# Supabase Configuration
# Get these from your Supabase project: https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Cloudinary Configuration
# Get these from your Cloudinary dashboard: https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# Mapbox Configuration
# Get this from Mapbox Studio: https://account.mapbox.com
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token

# Didit Identity Verification Configuration
# Get these from Didit Business Console: https://dashboard.didit.me → API & Webhooks
# This should be a single combined workflow configured to do ID verification + liveness + face match
DIDIT_API_KEY=your_didit_api_key
DIDIT_VERIFICATION_WORKFLOW_ID=your_combined_verification_workflow_id

# Resend Email Configuration
# Get this from Resend Dashboard: https://resend.com → API Keys
RESEND_API_KEY=your_resend_api_key
