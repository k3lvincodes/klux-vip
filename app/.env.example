# Environment Configuration
# =====================================================
# Build with --dart-define flags to inject these values at compile time.
# The .env file is NO LONGER bundled with the app for security.
#
# Build command example:
#   flutter build apk --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=...
#
# Or using a defines file (Flutter 3.27+):
#   flutter build apk --dart-define-from-file=.env
#
# For development with --dart-define-from-file:
#   Copy this file to .env, fill in your values, then run:
#   flutter run --dart-define-from-file=.env
# =====================================================

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# Mapbox Configuration
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token

# Didit Identity Verification Configuration
DIDIT_API_KEY=your_didit_api_key
DIDIT_VERIFICATION_WORKFLOW_ID=your_combined_verification_workflow_id
DIDIT_WEBHOOK_SECRET=your_didit_webhook_secret

# Resend Email Configuration
RESEND_API_KEY=your_resend_api_key
